---
import { canonicalPath, langFromPath, localizedUrl, hasEn, localizeHref } from '../lib/i18n.js';
interface Props {
  items?: { label: string; href: string }[];
  logo?: string;
  name?: string;
}
const { items = [], logo, name } = Astro.props;

// Toggle lingua: calcolato dal path corrente. ENG punta alla stessa pagina in /en/ se esiste,
// altrimenti alla home EN (durante il rollout progressivo).
const canonical = canonicalPath(Astro.url.pathname);
const curLang = langFromPath(Astro.url.pathname);
const itUrl = localizedUrl(canonical, 'it');
const engUrl = localizedUrl(canonical, 'en');
const engReady = hasEn(canonical);  // ENG attivo solo se la pagina ha la versione EN
---
<div class="topbar">
  <button class="menu-btn" id="menuOpen" aria-haspopup="dialog" aria-controls="menuOverlay">
    Menu
    <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span></span>
  </button>
</div>

<div class="overlay" id="menuOverlay" role="dialog" aria-modal="true" aria-label="Menu" data-open="false">
  <div class="overlay__bar">
    <div class="overlay__lang">
      <a href={itUrl} class:list={[curLang === 'it' && 'is-active']} aria-current={curLang === 'it' ? 'true' : undefined}>ITA</a>
      {engReady
        ? <a href={engUrl} class:list={[curLang === 'en' && 'is-active']} aria-current={curLang === 'en' ? 'true' : undefined}>ENG</a>
        : <a aria-disabled="true">ENG</a>}
    </div>
    {logo && <img class="overlay__logo" src={logo} alt={name} width="440" height="276" />}
    <button class="menu-btn menu-btn--close" id="menuClose" aria-label="Chiudi menu">
      Menu
      <span class="menu-btn__x" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="overlay__nav">
    {items.map((i) => <a href={localizeHref(i.href, curLang)}>{i.label}</a>)}
  </nav>
</div>

<script>
  const overlay = document.getElementById('menuOverlay');
  const set = (v) => {
    overlay?.setAttribute('data-open', String(v));
    document.body.style.overflow = v ? 'hidden' : '';
  };
  document.getElementById('menuOpen')?.addEventListener('click', () => set(true));
  document.getElementById('menuClose')?.addEventListener('click', () => set(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
